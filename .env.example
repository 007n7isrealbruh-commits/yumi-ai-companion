# ============================================================
# AI WAIFU APP — ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to version control.
# ============================================================

# --- Brain / LLM provider selection ---
# Which LLM actually generates her replies. "gemini" (default) uses the
# Gemini-specific settings below unchanged (and keeps web search + a
# thinking budget + vision, since those are native Gemini features).
# Anything else routes through one shared OpenAI-compatible client:
#   openai    -> OpenAI (GPT-4o, etc.)               needs LLM_API_KEY
#   groq      -> Groq (very fast/cheap Llama, etc.)  needs LLM_API_KEY
#   nvidia    -> NVIDIA NIM (build.nvidia.com)        needs LLM_API_KEY
#   deepseek  -> DeepSeek                              needs LLM_API_KEY
#   xai       -> xAI / Grok                            needs LLM_API_KEY
#   ollama    -> local, free, offline (run `ollama serve` first)
#   lmstudio  -> local, free, offline (start its local server first)
#   custom    -> any other OpenAI-compatible endpoint — set LLM_BASE_URL
# Full metadata (default base URLs, example models) is in
# backend/providers/registry.py, and also served live at GET /providers
# for the settings UI.
LLM_PROVIDER=gemini
# Model name for whichever LLM_PROVIDER you picked above (ignored for
# "gemini" — see GEMINI_MODEL below instead). Examples:
#   openai: gpt-4o-mini | groq: llama-3.3-70b-versatile
#   nvidia: meta/llama-3.1-70b-instruct | ollama: llama3.3
LLM_MODEL=
# API key for whichever LLM_PROVIDER you picked (not needed for ollama/lmstudio).
LLM_API_KEY=
# Override the provider's default base URL. Leave blank unless you're
# self-hosting (e.g. your own NIM container) or using "custom".
LLM_BASE_URL=

# --- Google Gemini (Brain / LLM) ---
# Required if LLM_PROVIDER=gemini (the default). If you picked a
# different provider above, this becomes OPTIONAL — but it's still worth
# setting if you have a free-tier key, because semantic memory's
# relevance ranking (embeddings) always uses Gemini regardless of which
# provider is your "brain". Leave it out entirely and memory just falls
# back to simpler keyword matching — nothing breaks either way.
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash has a genuine no-cost free tier on Google AI Studio
# (rate-limited, no card needed). gemini-3.8-flash is NOT free — it's
# $0.75/1M input + $3.75/1M output tokens — set it here only if you want
# to pay for the smarter model. GEMINI_FALLBACK_MODEL is used automatically
# if the primary model errors out or hits a rate limit.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=200
GEMINI_TEMPERATURE=0.9
# 0 = thinking off (fastest/cheapest), -1 = dynamic budget, or a fixed
# token count like 512. Only helps on genuinely tricky replies — leave at
# 0 unless you notice her giving shallow answers to complex questions.
GEMINI_THINKING_BUDGET=0
# Lets her use live Google Search for current events / facts she's unsure
# of. Uses the same free-tier Gemini call, no separate key needed.
GEMINI_ENABLE_SEARCH=true

# --- Fish Audio (Voice Synthesis / TTS) ---
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# s2.1-pro-free runs Fish Audio's best model (S2.1 Pro) at $0 under their
# fair-use policy. Leave FISH_AUDIO_VOICE_ID blank to use its default voice.
#
# TO USE A SPECIFIC VOICE (cloned or from the marketplace):
#   1. Go to https://fish.audio/ -> Discover (or "My Models" for a clone
#      you made), open the voice, and copy its Reference ID (via the
#      "Copy ID" button, or from the page URL).
#   2. Paste it below as FISH_AUDIO_VOICE_ID=<that id>
#      -- OR --
#      paste it directly into HARDCODED_VOICE_ID near the top of
#      backend/tts_engine.py if you'd rather not put it in .env.
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_FORMAT=mp3

# --- Speech-to-Text ---
# "google" uses the free SpeechRecognition Google Web Speech API (needs internet).
# "whisper" uses local faster-whisper (offline, needs more CPU/GPU).
STT_ENGINE=google
WHISPER_MODEL_SIZE=base
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8

# --- WebSocket Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Character ---
CHARACTER_NAME=Yumi
MEMORY_FILE_PATH=./backend/memory_store.json
